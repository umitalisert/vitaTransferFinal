{
  "cli": {
    "version": ">= 3.3.1",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "env": {
        "NPM_CONFIG_LEGACY_PEER_DEPS": "1"
      }
    },
    "preview": {
      "android": {
        "buildType": "apk"
      },
      "channel": "preview",
      "env": {
        "NPM_CONFIG_LEGACY_PEER_DEPS": "1"
      }
    },
    "production": {
      "channel": "production",
      "env": {
        "NPM_CONFIG_LEGACY_PEER_DEPS": "1"
      }
    }
  },
  "submit": {
    "production": {}
  }
}