{
  "name": "vitadrivetransfer",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web"
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "@expo/config",
          "@expo/metro-config",
          "expo-checkbox",
          "firebase",
          "moment",
          "react-native-phone-call",
          "react-native-calendar-strip",
          "react-native-otp-verify"
        ],
        "listUnknownPackages": false
      }
    }
  },
  "dependencies": {
    "@expo-google-fonts/nunito": "^0.2.2",
    "@expo/config": "~57.0.9",
    "@expo/vector-icons": "^15.0.2",
    "@gorhom/bottom-sheet": "^5.2.6",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-navigation/bottom-tabs": "^6.4.0",
    "@react-navigation/native": "^6.1.18",
    "@react-navigation/native-stack": "^6.11.0",
    "@reduxjs/toolkit": "^1.9.0",
    "axios": "^1.1.3",
    "compare-versions": "^6.1.1",
    "expo": "~57.0.24",
    "expo-camera": "~57.0.5",
    "expo-checkbox": "~57.0.0",
    "expo-device": "~57.0.2",
    "expo-document-picker": "~57.0.2",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-image": "~57.0.5",
    "expo-image-manipulator": "~57.0.19",
    "expo-image-picker": "~57.0.19",
    "expo-localization": "~57.0.2",
    "expo-location": "~57.0.19",
    "expo-notifications": "~57.0.20",
    "expo-sharing": "~57.0.21",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-task-manager": "~57.0.19",
    "expo-updates": "~57.0.23",
    "firebase": "^11.10.0",
    "lottie-react-native": "~7.3.8",
    "moment": "^2.29.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-calendar-strip": "^2.2.6",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-modal-datetime-picker": "^14.0.1",
    "react-native-otp-verify": "^1.2.0",
    "react-native-paper": "^5.13.1",
    "react-native-phone-call": "^1.2.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.1",
    "react-redux": "^8.0.5",
    "redux": "^4.2.0",
    "zustand": "^5.0.6"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@babel/plugin-transform-private-methods": "^7.25.9",
    "@types/react": "~19.2.0",
    "babel-plugin-transform-import-meta": "^2.3.3",
    "babel-preset-expo": "~57.0.12"
  },
  "private": true,
  "overrides": {
    "react": "$react",
    "react-dom": "$react-dom",
    "@types/react": "$@types/react",
    "@react-native-async-storage/async-storage": "$@react-native-async-storage/async-storage"
